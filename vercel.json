{
  "routes": [
    {
      "src": "/downloads/Bazar\\.apk",
      "dest": "/downloads/Bazar.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=Bazar.apk"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/store"
    }
  ]
}